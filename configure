#!/bin/sh
set -e

prefix=/usr/local
with_xtest=auto
CXX=${CXX:-g++}

usage()
{
    cat <<EOF
Usage: ./configure [options]

    --prefix=DIR        install prefix(default: /usr/local)
    --with-xtest=WHEN   Xtest sink: auto, yes, no (default: auto)
    --help              show this message
EOF
}

for arg in "$@"; do
    case "$arg" in
        --prefix=*)     prefix=${arg#*=} ;;
        --with-xtest=*) with_xtest=${arg#*=} ;;
        --help|-h)      usage; exit 0 ;;
        *) echo "unknown option: $arg" >&2; usage >&2; exit 1 ;;
    esac
done

case "$with_xtest" in
    auto|yes|no) ;;
    *) echo "--with-xtest must be auto, yes or no" >&2; exit 1 ;;
esac

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

try_compile()
{
    src=$1; shift
    printf '%s\n' "$src" > "$tmpdir/probe.cpp"
    $CXX "$tmpdir/probe.cpp" "$@" -o "$tmpdir/probe" >/dev/null 2>&1
}

have_xtest=0
xtest_libs=

if [ "$with_xtest" != no ]; then
    if pkg-config --exists xtst x11 2>/dev/null; then
        xtest_libs=$(pkg-config --libs xtst x11)
    else
        xtest_libs="-lXtst -lX11"
    fi

    probe='
#include <X11/Xlib.h>
#include <X11/extensions/XTest.h>
int main(void) { XTestFakeKeyEvent(0, 0, 0, 0); return 0; }
'

    if try_compile "$probe" $xtest_libs; then
        have_xtest=1
    else
        xtest_libs=
        if [ "$with_xtest" = yes ]; then
            echo "error: --with-xtest=yes, but libXtst/libX11 are not usable" >&2
            echo "      install the dev files (Arch: libxtst, Debian: libxtst-dev)" >&2
            exit 1
        fi
    fi
fi

cat > config.mk <<EOF
#generated by ./configure -- do not edit
PREFIX      := $prefix
HAVE_XTEST  := $have_xtest
XTEST_LIBS  := $xtest_libs
EOF

{
    echo "/* generated by ./configure -- do not edit */"
    echo "#pragma once"
    if [ "$have_xtest" = 1 ]; then
        echo "#define HAVE_XTEST 1"
    fi
} > config.h

echo
echo "  prefix:     $prefix"
if [ "$have_xtest" = 1 ]; then
    echo "  XTest sink: yes ($xtest_libs)"
else
    echo "  XTest sink: no"
fi
echo
echo "run 'make' to build."